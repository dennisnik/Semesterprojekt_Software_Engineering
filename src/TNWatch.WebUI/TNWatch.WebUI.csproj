<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>tnwatch-webui-6b1f3c2e</UserSecretsId>
    <!-- .NET 10: the SDK only adds the Blazor framework scripts (_framework/blazor.web.js) when it sees .razor
         files at restore time. The Dockerfile restores with just the project files, so state it explicitly. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TNWatch.Domain\TNWatch.Domain.csproj" />
    <ProjectReference Include="..\TNWatch.TelemetryIngestion\TNWatch.TelemetryIngestion.csproj" />
    <ProjectReference Include="..\TNWatch.Persistence\TNWatch.Persistence.csproj" />
    <ProjectReference Include="..\TNWatch.Alerting\TNWatch.Alerting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.15" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TNWatch.IntegrationTests" />
  </ItemGroup>

</Project>
