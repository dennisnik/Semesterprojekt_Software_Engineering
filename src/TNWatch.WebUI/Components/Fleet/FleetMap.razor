@* Full-screen Leaflet map with status-coloured pins (F04). In route mode, pins show selection bubbles (Mockup 1). *@
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="fleet-map" @ref="_element" aria-label="Karte der TrafficNodes"></div>

@code {
    private ElementReference _element;
    private IJSObjectReference? _module;
    private DotNetObjectReference<FleetMap>? _self;
    private string _lastSignature = string.Empty;

    [Parameter, EditorRequired] public IReadOnlyList<NodeSnapshot> Nodes { get; set; } = [];

    [Parameter] public int Version { get; set; }

    [Parameter] public bool RouteMode { get; set; }

    [Parameter] public IReadOnlyList<string> RouteSelection { get; set; } = [];

    [Parameter] public string? ActiveNodeId { get; set; }

    [Parameter, EditorRequired] public MapOptions Options { get; set; } = new();

    [Parameter] public EventCallback<string> OnNodeClick { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/fleetMap.js");
            _self = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("init", _element, _self, Options);
        }

        await SyncAsync();
    }

    private async Task SyncAsync()
    {
        if (_module is null)
        {
            return;
        }

        var signature = $"{Version}|{RouteMode}|{string.Join(',', RouteSelection)}|{ActiveNodeId}";
        if (signature == _lastSignature)
        {
            return;
        }

        _lastSignature = signature;
        var selected = RouteSelection.ToHashSet(StringComparer.Ordinal);
        var payload = Nodes.Select(n => new
        {
            id = n.Id,
            lat = n.Latitude,
            lon = n.Longitude,
            status = n.Status.ToString().ToLowerInvariant(),
            selected = selected.Contains(n.Id),
            active = n.Id == ActiveNodeId,
        });
        await _module.InvokeVoidAsync("setNodes", payload, RouteMode);
    }

    [JSInvokable]
    public Task OnMarkerClick(string id) => OnNodeClick.InvokeAsync(id);

    public async Task FocusAsync(string id)
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("focusNode", id);
        }
    }

    public async Task FitAllAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("fitAll");
        }
    }

    public async Task AnchorAsync(ElementReference? element, string? id)
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("anchorElement", element, id);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit already gone.
            }
        }

        _self?.Dispose();
    }
}
