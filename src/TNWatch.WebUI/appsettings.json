{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "TnWatch": "Host=localhost;Port=5432;Database=tnwatch;Username=tnwatch;Password=SET_VIA_ENVIRONMENT"
  },
  "Mqtt": {
    "Enabled": true,
    "Host": "mqtt.ti-labs.ai",
    "Port": 8883,
    "UseTls": true,
    "TolerateUnknownRevocation": true,
    "CleanSession": false,
    "ReconnectInterval": "00:00:03"
  },
  "Ingestion": {
    "TelemetryTopicPatterns": [ "traffic-device/{tenant}/trafficnode/{nodeId}/status" ],
    "BatteryEventTopicPatterns": [],
    "EventTimeZone": "Europe/Berlin"
  },
  "StatusRules": {
    "NormalMinVoltage": 12.4,
    "WarningMinVoltage": 11.8,
    "OfflineAfter": "00:30:00",
    "SmoothingWindow": 3
  },
  "Alerting": {
    "OfflineCheckInterval": "00:01:00"
  },
  "Simulator": {
    "StartEnabled": false,
    "NodeCount": 7,
    "Interval": "00:00:10",
    "Tenant": "simulation"
  },
  "Map": {
    "TileUrl": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
    "Attribution": "&copy; <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a>-Mitwirkende",
    "CenterLatitude": 48.78,
    "CenterLongitude": 9.25,
    "Zoom": 10
  },
  "Auth": {
    "Mode": "Oidc",
    "Authority": "",
    "ClientId": "tnwatch-web",
    "RequireHttpsMetadata": true
  }
}
