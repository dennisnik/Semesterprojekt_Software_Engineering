<?xml version="1.0" encoding="utf-8"?>
<!-- Coverage scope for NFA07: business and evaluation logic (parser, validation, status evaluation). -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[TNWatch.Domain]*,[TNWatch.TelemetryIngestion]*,[TNWatch.Alerting]*,[TNWatch.Persistence]*</Include>
          <ExcludeByFile>**/Migrations/*.cs</ExcludeByFile>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
