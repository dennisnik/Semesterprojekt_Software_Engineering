# Copy to deploy/.env (git-ignored) and replace every value before deploying.
# The values below are for LOCAL DEVELOPMENT ONLY (NFA08: no default passwords in production).

# --- Ports (course server: use our range 21300–21399, e.g. APP_PORT=21300, KEYCLOAK_PORT=21301) ---
APP_PORT=8080
KEYCLOAK_PORT=8081
DB_PORT=5432
APP_PUBLIC_URL=http://localhost:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8081

# --- PostgreSQL ---
POSTGRES_PASSWORD=tnwatch-dev

# --- Keycloak ---
KEYCLOAK_ADMIN_PASSWORD=change-me-admin
TNWATCH_CLIENT_SECRET=change-me-client-secret
# Initial password of the demo users markus / kevin / anja
TNWATCH_DEMO_PASSWORD=change-me-demo

# --- MQTT (course broker mqtt.ti-labs.ai:8883, credentials from the course – never commit them) ---
MQTT_ENABLED=true
MQTT_USERNAME=
MQTT_PASSWORD=
# Must be unique per running instance (local vs. server), otherwise the broker disconnects the other one.
MQTT_CLIENT_ID=tnwatch-local

# --- Simulator ---
SIMULATOR_START_ENABLED=false
